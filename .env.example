X_BEARER_TOKEN=
X_OWNED_USERNAME=

# Snowflake : utilisateur de service, auth par paire de clés (jamais de mot de passe).
# Voir sql/snowflake_setup.sql et la section Snowflake du README.
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USER=TWITTER_ANALYTICS_SVC
SNOWFLAKE_ROLE=TWITTER_ANALYTICS_ROLE
SNOWFLAKE_WAREHOUSE=TWITTER_ANALYTICS_WH
SNOWFLAKE_DATABASE=TWITTER_ANALYTICS
SNOWFLAKE_SCHEMA=ANALYTICS
# Corps de rsa_key.p8 en base64 sur UNE ligne (sans les lignes BEGIN/END),
# ou PEM complet entre guillemets doubles sur plusieurs lignes.
SNOWFLAKE_PRIVATE_KEY=<base64-private-key-body>
# Vide si la clé privée n'est pas chiffrée.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Uniquement pour scripts/migrate_supabase_to_snowflake.py (lecture de l'ancienne base).
SUPABASE_URL=
SUPABASE_KEY=
